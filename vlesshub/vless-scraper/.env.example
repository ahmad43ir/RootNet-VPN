# ============================================================
# 📁 .env.example — VLESS Telegram Scraper
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# ============================================================

# ─── Telegram API Credentials ─────────────────────────────────
# Get these from https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# ─── Telethon Session String ─────────────────────────────────
# Generate on your local machine FIRST:
#   python -c "
#   from telethon.sessions import StringSession
#   from telethon import TelegramClient
#   import asyncio
#   async def main():
#       client = TelegramClient(StringSession(), API_ID, API_HASH)
#       await client.start()
#       print('Session:', client.session.save())
#       await client.disconnect()
#   asyncio.run(main())
#   "
# Then paste the output here.
TELEGRAM_SESSION=your_string_session_here

# ─── Supabase Credentials ────────────────────────────────────
# From: https://app.supabase.com/project/YOUR_REF/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here

# ─── Channel Configuration ───────────────────────────────────
# Comma-separated list of Telegram channel usernames (without @)
# The bot must be a member of these channels to receive messages.
CHANNELS=channel_one,channel_two,channel_three

# ─── Cleanup Configuration ──────────────────────────────────
# How often to check for and delete old links (in minutes)
CLEANUP_INTERVAL=60

# Maximum age of links in hours before auto-deletion
# (default: 36 hours as per requirements)
MAX_AGE_HOURS=36
